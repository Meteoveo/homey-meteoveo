  ],
  "name": {
    "en": "MeteoVeo",
    "es": "MeteoVeo"
  },
  "description": {
    "en": "Know when it will rain at home in Spain, minute by minute",
    "es": "Sabe cuándo va a llover en tu casa, minuto a minuto"
  },
  "category": [
    "climate"
  ],
  "permissions": [
    "homey:manager:api",
    "homey:manager:geolocation"
  ],
  "brandColor": "#2b6fa8",
  "tags": {
    "en": [
      "weather",
      "rain",
      "forecast",
      "nowcast",
      "spain",
      "aemet",
      "weather station",
      "warnings"
    ],
    "es": [
      "tiempo",
      "lluvia",
      "previsión",
      "radar",
      "españa",
      "aemet",
      "estación meteorológica",
      "avisos"
    ]
  },
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "author": {
    "name": "Zsolt Reinhardt",
    "email": "zsolt@meteoveo.com"
  },
  "contributors": {
    "developers": [
      {
        "name": "Zsolt Reinhardt",
        "email": "zsolt@meteoveo.com"
      }
    ]
  },
  "homepage": "https://www.meteoveo.com",
