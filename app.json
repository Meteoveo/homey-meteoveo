  "bugs": {
    "url": "https://github.com/Meteoveo/homey-meteoveo/issues"
  },
  "flow": {
    "triggers": [
      {
        "id": "rain_expected",
        "title": {
          "en": "Rain is on its way",
          "es": "Va a empezar a llover"
        },
        "hint": {
          "en": "Once per dry spell, when the next-hour forecast first shows rain coming.",
          "es": "Una vez por cada periodo seco, cuando la previsión de la próxima hora muestra lluvia en camino."
        },
        "tokens": [
          {
            "name": "minutes",
            "type": "number",
            "title": {
              "en": "Minutes until rain",
              "es": "Minutos hasta la lluvia"
            },
            "example": 25
          },
          {
            "name": "intensity",
            "type": "string",
            "title": {
              "en": "Intensity",
              "es": "Intensidad"
            },
            "example": {
              "en": "moderate",
              "es": "moderada"
            }
          },
          {
            "name": "radar",
            "type": "image",
            "title": {
              "en": "Radar image",
              "es": "Imagen del radar"
            }
          }
        ],
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=meteoveo"
          }
        ]
      },
      {
        "id": "rain_started",
        "title": {
          "en": "It started raining",
          "es": "Ha empezado a llover"
        },
        "tokens": [
          {
            "name": "radar",
            "type": "image",
            "title": {
              "en": "Radar image",
              "es": "Imagen del radar"
            }
          }
        ],
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=meteoveo"
          }
        ]
      },
      {
        "id": "rain_stopped",
        "title": {
          "en": "It stopped raining",
          "es": "Ha dejado de llover"
        },
        "hint": {
          "en": "After ten minutes without rain, so a short break in a shower does not count.",
          "es": "Tras diez minutos sin lluvia, para que una pausa breve en un chubasco no cuente."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=meteoveo"
          }
        ]
      },
      {
        "id": "warning_issued",
        "title": {
          "en": "A weather warning is issued",
          "es": "Se activa un aviso"
        },
        "tokens": [
          {
            "name": "level",
            "type": "string",
            "title": {
              "en": "Level",
              "es": "Nivel"
            },
            "example": {
              "en": "Orange",
              "es": "Naranja"
            }
          },
          {
            "name": "phenomenon",
            "type": "string",
            "title": {
              "en": "Phenomenon",
              "es": "Fenómeno"
            },
            "example": "Lluvias"
          },
          {
            "name": "headline",
            "type": "string",
            "title": {
              "en": "Text (AEMET)",
              "es": "Texto (AEMET)"
            },
            "example": "Acumulación de 40 mm en 12 horas"
          },
          {
            "name": "onset",
            "type": "string",
            "title": {
              "en": "Starts",
              "es": "Empieza"
            },
            "example": "23/10 20:00"
          },
          {
            "name": "expires",
            "type": "string",
            "title": {
              "en": "Ends",
              "es": "Termina"
            },
            "example": "24/10 08:00"
          },
          {
            "name": "radar",
            "type": "image",
            "title": {
              "en": "Radar image",
              "es": "Imagen del radar"
            }
          }
        ],
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=meteoveo"
          }
        ]
      },
      {
        "id": "condition_changed",
        "title": {
          "en": "The conditions changed",
          "es": "Cambia el estado del cielo"
        },
        "tokens": [
          {
            "name": "condition",
            "type": "string",
            "title": {
              "en": "Conditions",
              "es": "Estado del cielo"
            },
            "example": {
              "en": "Showers",
              "es": "Chubascos"
            }
          }
        ],
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=meteoveo"
          }
        ]
      },
      {
        "id": "rain_ending",
        "title": {
          "en": "Rain is about to stop",
          "es": "Va a dejar de llover"
        },
        "hint": {
          "en": "Once per shower, when the next-hour forecast first shows when the rain ends.",
          "es": "Una vez por chubasco, cuando la previsión de la próxima hora muestra por primera vez cuándo para."
        },
        "tokens": [
          {
            "name": "minutes",
            "type": "number",
            "title": {
              "en": "Minutes until it stops",
              "es": "Minutos hasta que pare"
            },
            "example": 15
          }
        ],
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=meteoveo"
          }
        ]
      },
      {
        "id": "warning_level_changed",
        "title": {
          "en": "The warning level changed",
          "es": "Cambia el nivel de aviso"
        },
        "tokens": [
          {
            "name": "level",
            "type": "string",
            "title": {
              "en": "New level",
              "es": "Nivel nuevo"
            },
            "example": {
              "en": "Orange",
              "es": "Naranja"
            }
          },
          {
            "name": "previous",
            "type": "string",
            "title": {
              "en": "Previous level",
              "es": "Nivel anterior"
            },
            "example": {
              "en": "Yellow",
              "es": "Amarillo"
            }
          }
        ],
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=meteoveo"
          }
        ]
      },
      {
        "id": "warning_cleared",
        "title": {
          "en": "No more active warnings",
          "es": "Ya no hay avisos activos"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=meteoveo"
          }
        ]
      }
    ],
