{
  "name": {
    "en": "Forecast for your home",
    "es": "Previsión para tu casa"
  },
  "class": "sensor",
  "platforms": [
    "local"
  ],
  "connectivity": [
    "cloud"
  ],
  "capabilities": [
    "meteoveo_condition",
    "measure_temperature",
    "measure_humidity",
    "measure_pressure",
    "measure_wind_strength",
    "measure_gust_strength",
    "measure_wind_angle",
    "measure_ultraviolet",
    "meteoveo_rain_soon",
    "meteoveo_rain_start",
    "meteoveo_warning",
    "measure_temperature.max_today",
    "measure_temperature.min_today",
    "measure_temperature.max_tomorrow",
    "measure_temperature.min_tomorrow",
    "measure_ultraviolet.max_today"
  ],
  "capabilitiesOptions": {
    "measure_temperature": {
      "decimals": 1
    },
    "measure_wind_strength": {
      "decimals": 0
    },
    "measure_gust_strength": {
      "decimals": 0
    },
    "measure_temperature.max_today": {
      "title": {
        "en": "Maximum today",
        "es": "Máxima de hoy"
      },
      "decimals": 0
    },
    "measure_temperature.min_today": {
      "title": {
        "en": "Minimum today",
        "es": "Mínima de hoy"
      },
      "decimals": 0
    },
    "measure_temperature.max_tomorrow": {
      "title": {
        "en": "Maximum tomorrow",
        "es": "Máxima de mañana"
      },
      "decimals": 0
    },
    "measure_temperature.min_tomorrow": {
      "title": {
        "en": "Minimum tomorrow",
        "es": "Mínima de mañana"
      },
      "decimals": 0
    },
    "measure_ultraviolet.max_today": {
      "title": {
        "en": "UV maximum today",
        "es": "UV máximo de hoy"
      }
    }
  },
  "images": {
    "small": "{{driverAssetsPath}}/images/small.png",
    "large": "{{driverAssetsPath}}/images/large.png",
    "xlarge": "{{driverAssetsPath}}/images/xlarge.png"
  },
  "pair": [
    {
      "id": "account"
    },
    {
      "id": "verify"
    },
    {
      "id": "location"
    },
    {
      "id": "station"
    }
  ],
  "repair": [
    {
      "id": "repair"
    }
  ]
}
