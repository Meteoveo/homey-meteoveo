{
  "name": {
    "en": "MeteoVeo location",
    "es": "Ubicación de MeteoVeo"
  },
  "class": "sensor",
  "platforms": [
    "local"
  ],
  "connectivity": [
    "cloud"
  ],
  "capabilities": [
    "meteoveo_condition",
    "measure_temperature",
    "measure_humidity",
    "measure_pressure",
    "measure_wind_strength",
    "measure_gust_strength",
    "measure_wind_angle",
    "measure_ultraviolet",
    "meteoveo_rain_soon",
    "meteoveo_rain_start",
    "meteoveo_warning",
    "measure_temperature.max_today",
    "measure_temperature.min_today",
    "measure_temperature.max_tomorrow",
    "measure_temperature.min_tomorrow",
    "measure_ultraviolet.max_today",
    "measure_temperature.feels_like",
    "measure_temperature.dew_point"
  ],
  "capabilitiesOptions": {
    "measure_temperature": {
      "decimals": 1
    },
    "measure_wind_strength": {
      "decimals": 0
    },
    "measure_gust_strength": {
      "decimals": 0
    },
    "measure_temperature.max_today": {
      "title": {
        "en": "Maximum today",
        "es": "Máxima de hoy"
      },
      "decimals": 0
    },
    "measure_temperature.min_today": {
      "title": {
        "en": "Minimum today",
        "es": "Mínima de hoy"
      },
      "decimals": 0
    },
    "measure_temperature.max_tomorrow": {
      "title": {
        "en": "Maximum tomorrow",
        "es": "Máxima de mañana"
      },
      "decimals": 0
    },
    "measure_temperature.min_tomorrow": {
      "title": {
        "en": "Minimum tomorrow",
        "es": "Mínima de mañana"
      },
      "decimals": 0
    },
    "measure_ultraviolet.max_today": {
      "title": {
        "en": "UV index maximum today",
        "es": "Índice UV máximo de hoy"
      }
    },
    "measure_temperature.feels_like": {
      "title": {
        "en": "Feels like",
        "es": "Sensación térmica"
      },
      "decimals": 1
    },
    "measure_temperature.dew_point": {
      "title": {
        "en": "Dew point",
        "es": "Punto de rocío"
      },
      "decimals": 1
    }
  },
  "images": {
    "small": "{{driverAssetsPath}}/images/small.png",
    "large": "{{driverAssetsPath}}/images/large.png",
    "xlarge": "{{driverAssetsPath}}/images/xlarge.png"
  },
  "pair": [
    {
      "id": "account"
    },
    {
      "id": "verify"
    },
    {
      "id": "location"
    },
    {
      "id": "station"
    }
  ],
  "repair": [
    {
      "id": "repair"
    }
  ],
  "settings": [
    {
      "type": "group",
      "label": {
        "en": "Notifications",
        "es": "Notificaciones"
      },
      "children": [
        {
          "id": "notify_warnings",
          "type": "dropdown",
          "value": "orange",
          "label": {
            "en": "AEMET warnings in the timeline",
            "es": "Avisos de AEMET en la línea de tiempo"
          },
          "hint": {
            "en": "A notification in the Homey timeline when AEMET issues a warning for your area. No Flow needed.",
            "es": "Una notificación en la línea de tiempo de Homey cuando AEMET activa un aviso en tu zona. Sin crear ningún Flow."
          },
          "values": [
            {
              "id": "off",
              "label": {
                "en": "Off",
                "es": "Desactivado"
              }
            },
            {
              "id": "yellow",
              "label": {
                "en": "Yellow and above",
                "es": "Amarillo o superior"
              }
            },
            {
              "id": "orange",
              "label": {
                "en": "Orange and red",
                "es": "Naranja y rojo"
              }
            },
            {
              "id": "red",
              "label": {
                "en": "Red only",
                "es": "Solo rojo"
              }
            }
          ]
        },
        {
          "id": "notify_rain",
          "type": "checkbox",
          "value": false,
          "label": {
            "en": "Rain on its way, in the timeline",
            "es": "Lluvia en camino, en la línea de tiempo"
          },
          "hint": {
            "en": "A notification when the next-hour forecast first shows rain on its way.",
            "es": "Una notificación cuando la previsión de la próxima hora muestra por primera vez lluvia en camino."
          }
        }
      ]
    }
  ]
}
