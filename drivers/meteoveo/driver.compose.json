{
  "name": {
    "en": "Forecast for your home",
    "es": "Previsión para tu casa"
  },
  "class": "sensor",
  "platforms": [
    "local"
  ],
  "connectivity": [
    "cloud"
  ],
  "capabilities": [
    "meteoveo_condition",
    "measure_temperature",
    "measure_humidity",
    "measure_pressure",
    "measure_wind_strength",
    "measure_gust_strength",
    "measure_wind_angle",
    "measure_ultraviolet",
    "meteoveo_rain_soon",
    "meteoveo_rain_start",
    "meteoveo_warning"
  ],
  "capabilitiesOptions": {
    "measure_temperature": {
      "decimals": 1
    },
    "measure_wind_strength": {
      "decimals": 0
    },
    "measure_gust_strength": {
      "decimals": 0
    }
  },
  "images": {
    "small": "{{driverAssetsPath}}/images/small.png",
    "large": "{{driverAssetsPath}}/images/large.png",
    "xlarge": "{{driverAssetsPath}}/images/xlarge.png"
  },
  "pair": [
    {
      "id": "account"
    },
    {
      "id": "verify"
    },
    {
      "id": "location"
    },
    {
      "id": "station"
    }
  ],
  "repair": [
    {
      "id": "repair"
    }
  ]
}
